# SafeChat Backend Environment Configuration
# Copy to .env and fill in values. Never commit .env

# Application
APP_NAME=SafeChat
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=safechat
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Redis (optional - leave empty for in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Media storage
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_PATH=./storage
MEDIA_MAX_SIZE_MB=25
# S3-compatible (optional)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Firebase Cloud Messaging (optional)
FCM_CREDENTIALS_JSON=
FCM_ENABLED=false

# WebRTC / STUN / TURN
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=100/minute

# Logging & Archives
LOG_LEVEL=INFO
ARCHIVE_RETENTION_DAYS=365
ARCHIVE_STORAGE_PATH=./archives

# Admin bootstrap (first run only)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeImmediately123!
BOOTSTRAP_ADMIN_EMAIL=admin@safechat.local
# SMS verification - development simulates delivery and returns a temporary code to the UI.
SMS_MODE=development
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
OTP_EXPIRE_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
