@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap');

:root {
  --ink: #0f172a;
  --ink-soft: #334155;
  --muted: #64748b;
  --line: #e8ecf3;
  --line-strong: #d5dce8;
  --surface: #ffffff;
  --surface-2: #f8fafc;
  --surface-3: #f1f5f9;
  --bg: #f4f6fb;
  --brand-red: #e3404c;
  --brand-purple: #7b2cbf;
  --brand-magenta: #9c31a1;
  --brand-blue: #5b8def;
  --brand-orange: #f59e0b;
  --green: #10b981;
  --green-soft: #d1fae5;
  --red-soft: #fee2e6;
  --orange-soft: #fef3c7;
  --purple-soft: #f3e8ff;
  --blue-soft: #e8f0fe;
  --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
  --shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 20px 50px rgba(15, 23, 42, 0.1);
  --radius: 16px;
  --radius-sm: 10px;
  --sidebar: 260px;
  --font: 'Inter', system-ui, sans-serif;
  --display: 'Manrope', 'Inter', sans-serif;
  color-scheme: light;
}

[data-theme='dark'] {
  --ink: #f1f5f9;
  --ink-soft: #cbd5e1;
  --muted: #94a3b8;
  --line: #1e293b;
  --line-strong: #334155;
  --surface: #0f172a;
  --surface-2: #111827;
  --surface-3: #1e293b;
  --bg: #0b1220;
  --purple-soft: #2e1065;
  --red-soft: #3f1219;
  --orange-soft: #3b2a0a;
  --green-soft: #064e3b;
  --blue-soft: #0c1e3d;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.35);
  --shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.45);
  color-scheme: dark;
}

* { box-sizing: border-box; }
html, body, #root { min-height: 100%; }
body {
  margin: 0;
  min-width: 360px;
  font-family: var(--font);
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; }
button:disabled { cursor: not-allowed; opacity: 0.45; }
a { color: inherit; }

/* ── Shell ─────────────────────────────────────────── */
.app-shell { min-height: 100vh; display: flex; background: var(--bg); }
.sidebar {
  width: var(--sidebar);
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 40;
  display: flex;
  flex-direction: column;
  padding: 20px 14px 14px;
  color: #e2e8f0;
  background:
    radial-gradient(120% 80% at 0% 0%, rgba(123, 44, 191, 0.28), transparent 55%),
    radial-gradient(100% 60% at 100% 100%, rgba(227, 64, 76, 0.12), transparent 50%),
    linear-gradient(180deg, #0b1020 0%, #111827 100%);
  border-right: 1px solid rgba(255,255,255,0.05);
}
.brand, .login-brand { display: flex; align-items: center; gap: 12px; padding: 4px 10px 28px; }
.brand-symbol { width: 36px; height: 36px; flex: 0 0 36px; }
.brand-wordmark {
  display: block;
  font: 800 17px/1.15 var(--display);
  letter-spacing: -0.4px;
  color: #fff;
}
.brand-wordmark .word-safe { color: var(--brand-red); }
.brand-wordmark .word-chat { color: #c4a0e8; }
.brand-wordmark i { color: var(--brand-blue); font-style: normal; }
.brand-copy small {
  display: block;
  margin-top: 4px;
  color: #8b93a7;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.4px;
  text-transform: uppercase;
}
.workspace-label {
  padding: 0 12px 10px;
  color: #7c8599;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}
.nav-list { display: grid; gap: 3px; }
.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 42px;
  padding: 0 12px;
  border-radius: 12px;
  color: #a8b0c2;
  text-align: left;
  font-size: 13px;
  font-weight: 600;
  transition: background .15s, color .15s, transform .12s;
}
.nav-item:hover { color: #fff; background: rgba(255,255,255,0.05); }
.nav-item.nav-active {
  color: #fff;
  background: linear-gradient(90deg, rgba(123,44,191,0.35), rgba(156,49,161,0.12));
  box-shadow: inset 3px 0 0 var(--brand-red);
}
.nav-item.nav-active svg { color: #d4b4f0; }
.nav-item span:nth-child(2) { flex: 1; }
.nav-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--brand-orange);
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18);
}
.sidebar-bottom { margin-top: auto; }
.secure-note {
  display: flex; align-items: center; gap: 8px;
  margin: 0 6px 12px; padding: 11px 10px;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  color: #9aa3b8;
  font-size: 11px;
  background: rgba(255,255,255,0.03);
}
.secure-note svg { color: #6ee7b7; }
.secure-note span { flex: 1; }
.secure-note i, .online-label i, .audit-live i {
  width: 6px; height: 6px; display: inline-block; border-radius: 50%;
  background: #34d399; box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.2);
}
.profile-button {
  width: 100%; display: flex; align-items: center; gap: 10px;
  padding: 12px 10px; border-top: 1px solid rgba(255,255,255,0.08);
  color: #fff; text-align: left;
}
.profile-copy { flex: 1; min-width: 0; }
.profile-copy strong {
  display: block; overflow: hidden; text-overflow: ellipsis;
  color: #f1f5f9; font-size: 12px; font-weight: 700;
}
.profile-copy small { display: block; margin-top: 3px; color: #8b93a7; font-size: 11px; }
.profile-logout { color: #94a3b8; padding: 6px; border-radius: 8px; }
.profile-logout:hover { background: rgba(255,255,255,0.06); color: #fff; }

.main-area { flex: 1; min-height: 100vh; margin-left: var(--sidebar); }
.topbar {
  height: 64px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 32px;
  border-bottom: 1px solid var(--line);
  background: color-mix(in srgb, var(--surface) 88%, transparent);
  backdrop-filter: blur(12px);
  position: sticky; top: 0; z-index: 30;
}
.breadcrumbs { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; font-weight: 500; }
.breadcrumbs strong { color: var(--ink); font-weight: 700; }
.crumb-slash { color: var(--line-strong); }
.topbar-right { display: flex; align-items: center; gap: 12px; }
.role-pill {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 10px;
  border: 1px solid color-mix(in srgb, var(--brand-purple) 22%, transparent);
  border-radius: 999px;
  color: var(--brand-purple);
  background: var(--purple-soft);
  font-size: 10px; font-weight: 800; letter-spacing: 0.4px;
}
.avatar {
  width: 34px; height: 34px; flex: 0 0 34px;
  display: grid; place-items: center;
  border-radius: 12px;
  font-size: 11px; font-weight: 800;
}
.avatar-purple { color: #fff; background: linear-gradient(145deg, var(--brand-magenta), var(--brand-purple)); }
.avatar-muted { color: var(--muted); background: var(--surface-3); }
.avatar-online { color: #047857; background: var(--green-soft); box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px #34d399; }

.page-content { max-width: 1400px; margin: 0 auto; padding: 28px 32px 56px; }
.page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 22px; }
.page-heading h1 {
  margin: 0;
  font: 800 28px/1.15 var(--display);
  letter-spacing: -0.6px;
  color: var(--ink);
}
.page-heading p { margin: 6px 0 0; color: var(--muted); font-size: 14px; font-weight: 500; max-width: 52ch; }
.eyebrow {
  margin: 0 0 6px;
  color: var(--muted);
  font-size: 10px; font-weight: 800;
  letter-spacing: 1.3px; text-transform: uppercase;
}

/* ── Cards / panels ────────────────────────────────── */
.panel, .metric-card, .login-card, .request-card, .ticket-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}
.panel { padding: 20px; }
.panel-heading, .panel-table-heading {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  margin-bottom: 16px;
}
.panel-heading h2, .panel-table-heading h2 {
  margin: 0;
  font: 700 16px/1.3 var(--display);
  letter-spacing: -0.2px;
}
.panel-heading-icon { color: var(--muted); opacity: 0.7; }

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 18px;
}
.metric-card {
  position: relative;
  padding: 18px 18px 16px;
  overflow: hidden;
  transition: transform .15s, box-shadow .15s;
}
.metric-card:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
.metric-card .metric-icon {
  width: 36px; height: 36px; display: grid; place-items: center;
  border-radius: 12px; margin-bottom: 14px;
}
.metric-card.tone-purple .metric-icon { background: var(--purple-soft); color: var(--brand-purple); }
.metric-card.tone-green .metric-icon { background: var(--green-soft); color: var(--green); }
.metric-card.tone-orange .metric-icon { background: var(--orange-soft); color: var(--brand-orange); }
.metric-card.tone-blue .metric-icon { background: var(--blue-soft); color: var(--brand-blue); }
.metric-card.tone-red .metric-icon { background: var(--red-soft); color: var(--brand-red); }
.metric-card strong {
  display: block;
  font: 800 28px/1 var(--display);
  letter-spacing: -0.8px;
  color: var(--ink);
}
.metric-card span { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; font-weight: 600; }
.metric-card small { display: block; margin-top: 10px; color: var(--ink-soft); font-size: 12px; font-weight: 500; }

.split-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 14px;
  margin-top: 14px;
}

/* ── Toolbar / filters ─────────────────────────────── */
.toolbar {
  display: flex; flex-wrap: wrap; gap: 10px; align-items: center;
  margin-bottom: 16px;
}
.search-form {
  flex: 1; min-width: 240px;
  display: flex; align-items: center; gap: 10px;
  padding: 0 14px;
  height: 44px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.search-form svg { color: var(--muted); flex: 0 0 auto; }
.search-form input {
  flex: 1; border: 0; outline: none; background: transparent;
  font-size: 13px; font-weight: 500; min-width: 0;
}
.search-form button {
  height: 30px; padding: 0 12px;
  border-radius: 999px;
  background: var(--brand-purple); color: #fff;
  font-size: 12px; font-weight: 700;
}
.select-input, .text-input, .textarea-input {
  height: 44px;
  padding: 0 14px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--surface);
  font-size: 13px; font-weight: 500;
  outline: none;
  box-shadow: var(--shadow-sm);
}
.select-input:focus, .text-input:focus, .textarea-input:focus, .search-form:focus-within {
  border-color: color-mix(in srgb, var(--brand-purple) 45%, var(--line));
  box-shadow: 0 0 0 3px rgba(123, 44, 191, 0.12);
}
.textarea-input { height: auto; padding: 12px 14px; resize: vertical; min-height: 96px; }

/* ── Tables ────────────────────────────────────────── */
.table-panel { padding: 0; overflow: hidden; }
.table-caption {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--line);
  font-size: 12px; font-weight: 600; color: var(--muted);
}
.table-caption strong { color: var(--ink); font-weight: 800; }
.table-caption-right { display: flex; align-items: center; gap: 8px; }
.live-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
}
.table-scroll { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th {
  text-align: left;
  padding: 11px 18px;
  color: var(--muted);
  font-size: 10px; font-weight: 800;
  letter-spacing: 0.8px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--line);
}
td {
  padding: 14px 18px;
  border-bottom: 1px solid var(--line);
  vertical-align: middle;
  font-size: 13px;
}
tr:last-child td { border-bottom: 0; }
tr:hover td { background: color-mix(in srgb, var(--surface-2) 70%, transparent); }
.user-cell { display: flex; align-items: center; gap: 12px; min-width: 200px; }
.user-cell strong { display: block; font-size: 13px; font-weight: 700; }
.user-cell small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; font-weight: 500; }
.actions-heading { text-align: right; }
.row-actions { display: flex; justify-content: flex-end; gap: 6px; flex-wrap: wrap; }

/* ── Buttons / chips ───────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  height: 34px; padding: 0 12px;
  border-radius: 10px;
  font-size: 12px; font-weight: 700;
  transition: background .15s, color .15s, border-color .15s, transform .1s;
}
.btn:active { transform: scale(0.98); }
.btn-ghost {
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--ink-soft);
}
.btn-ghost:hover { background: var(--surface-2); }
.btn-primary {
  background: linear-gradient(135deg, var(--brand-purple), var(--brand-magenta));
  color: #fff;
  box-shadow: 0 6px 16px rgba(123, 44, 191, 0.25);
}
.btn-primary:hover { filter: brightness(1.05); }
.btn-danger {
  background: var(--red-soft);
  color: var(--brand-red);
  border: 1px solid color-mix(in srgb, var(--brand-red) 18%, transparent);
}
.btn-danger:hover { background: color-mix(in srgb, var(--brand-red) 14%, var(--surface)); }
.btn-soft {
  background: var(--purple-soft);
  color: var(--brand-purple);
}
.btn-sm { height: 30px; padding: 0 10px; font-size: 11px; border-radius: 8px; }
.icon-btn {
  width: 34px; height: 34px; display: grid; place-items: center;
  border-radius: 10px; color: var(--muted);
  border: 1px solid transparent;
}
.icon-btn:hover { background: var(--surface-2); color: var(--ink); border-color: var(--line); }

.chip, .status-chip, .plan-chip, .count-chip {
  display: inline-flex; align-items: center; gap: 5px;
  height: 24px; padding: 0 9px;
  border-radius: 999px;
  font-size: 11px; font-weight: 700;
  white-space: nowrap;
}
.status-chip.active, .chip-green { background: var(--green-soft); color: #047857; }
.status-chip.banned, .chip-red { background: var(--red-soft); color: var(--brand-red); }
.status-chip.deactivated, .chip-gray { background: var(--surface-3); color: var(--muted); }
.status-chip.pending_review, .chip-orange { background: var(--orange-soft); color: #b45309; }
.plan-chip.premium { background: var(--purple-soft); color: var(--brand-purple); }
.plan-chip.pro { background: var(--blue-soft); color: #1d4ed8; }
.count-chip { background: var(--surface-3); color: var(--ink-soft); }

/* ── Action menu ───────────────────────────────────── */
.menu-wrap { position: relative; }
.menu-popover {
  position: absolute; right: 0; top: calc(100% + 6px); z-index: 20;
  min-width: 220px;
  padding: 6px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--surface);
  box-shadow: var(--shadow-lg);
}
.menu-popover button {
  width: 100%;
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  text-align: left;
  font-size: 12px; font-weight: 600;
  color: var(--ink);
}
.menu-popover button:hover { background: var(--surface-2); }
.menu-popover button.danger { color: var(--brand-red); }
.menu-popover button.danger:hover { background: var(--red-soft); }
.menu-sep { height: 1px; margin: 4px 8px; background: var(--line); }

/* ── Modal ─────────────────────────────────────────── */
.modal-backdrop {
  position: fixed; inset: 0; z-index: 80;
  display: grid; place-items: center;
  padding: 20px;
  background: rgba(15, 23, 42, 0.48);
  backdrop-filter: blur(6px);
}
.modal {
  width: min(460px, 100%);
  padding: 22px;
  border-radius: 20px;
  background: var(--surface);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-lg);
}
.modal h3 {
  margin: 0 0 8px;
  font: 800 18px/1.25 var(--display);
  letter-spacing: -0.3px;
}
.modal p { margin: 0 0 14px; color: var(--muted); font-size: 13px; line-height: 1.5; }
.modal .warn-box {
  padding: 12px 14px;
  border-radius: 12px;
  background: var(--red-soft);
  color: #9f1239;
  font-size: 12px; font-weight: 600;
  margin-bottom: 14px;
}
.modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 16px; }

/* ── Login ─────────────────────────────────────────── */
.login-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(80% 60% at 10% 10%, rgba(123,44,191,0.14), transparent 55%),
    radial-gradient(70% 50% at 90% 90%, rgba(227,64,76,0.1), transparent 50%),
    var(--bg);
}
.login-card {
  width: min(420px, 100%);
  padding: 32px 28px;
  box-shadow: var(--shadow);
}
.login-card h1 {
  margin: 8px 0 6px;
  font: 800 24px/1.2 var(--display);
  letter-spacing: -0.5px;
}
.login-card .sub { margin: 0 0 22px; color: var(--muted); font-size: 13px; }
.field { display: grid; gap: 6px; margin-bottom: 14px; }
.field label { font-size: 12px; font-weight: 700; color: var(--ink-soft); }
.login-card .btn-primary { width: 100%; height: 44px; border-radius: 12px; font-size: 14px; }

/* ── Support / misc ────────────────────────────────── */
.request-list, .ticket-list { display: grid; gap: 12px; }
.request-card, .ticket-card { padding: 16px; }
.request-user { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.request-reason small, .meta-label {
  display: block; margin-bottom: 4px;
  font-size: 10px; font-weight: 800; letter-spacing: 0.8px; color: var(--muted);
}
.error-banner, .toast {
  padding: 12px 14px;
  border-radius: 12px;
  font-size: 13px; font-weight: 600;
  margin-bottom: 14px;
}
.error-banner { background: var(--red-soft); color: var(--brand-red); }
.toast {
  position: fixed; right: 20px; bottom: 20px; z-index: 90;
  min-width: 240px;
  box-shadow: var(--shadow);
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
}
.toast.success { border-left: 3px solid var(--green); }
.toast.error { border-left: 3px solid var(--brand-red); }
.toast.info { border-left: 3px solid var(--brand-blue); }
.empty-state {
  display: grid; place-items: center; gap: 10px;
  padding: 48px 20px;
  color: var(--muted); font-size: 13px; font-weight: 600;
}
.spin { animation: spin 0.9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.pagination {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; padding: 14px 18px; border-top: 1px solid var(--line);
  font-size: 12px; font-weight: 600; color: var(--muted);
}
.pagination-controls { display: flex; gap: 8px; }

.status-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; padding: 10px 0;
  border-bottom: 1px solid var(--line);
  font-size: 13px;
}
.status-row:last-child { border-bottom: 0; }
.status-bar {
  flex: 1; height: 6px; border-radius: 999px; background: var(--surface-3); overflow: hidden; margin: 0 14px;
}
.status-bar > i { display: block; height: 100%; border-radius: inherit; }
.status-bar.tone-green > i { background: var(--green); }
.status-bar.tone-red > i { background: var(--brand-red); }
.status-bar.tone-gray > i { background: #94a3b8; }
.status-bar.tone-orange > i { background: var(--brand-orange); }

.queue-row {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 0; border-bottom: 1px solid var(--line);
}
.queue-row:last-child { border-bottom: 0; }
.queue-row span:nth-child(2) { flex: 1; min-width: 0; }
.queue-row strong { display: block; font-size: 13px; }
.queue-row small { color: var(--muted); font-size: 12px; }
.queue-row b { font-size: 16px; font-weight: 800; font-family: var(--display); }
.queue-icon {
  width: 36px; height: 36px; display: grid; place-items: center; border-radius: 12px;
}
.queue-purple { background: var(--purple-soft); color: var(--brand-purple); }
.queue-orange { background: var(--orange-soft); color: var(--brand-orange); }

.mobile-menu-btn { display: none; }
.sidebar-overlay { display: none; }

/* ── Responsive ────────────────────────────────────── */
@media (max-width: 1100px) {
  .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .split-grid { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-105%);
    transition: transform .2s ease;
  }
  .sidebar.open { transform: translateX(0); }
  .main-area { margin-left: 0; }
  .mobile-menu-btn { display: grid; place-items: center; }
  .sidebar-overlay.open {
    display: block;
    position: fixed; inset: 0; z-index: 35;
    background: rgba(15, 23, 42, 0.4);
  }
  .page-content { padding: 20px 16px 40px; }
  .topbar { padding: 0 16px; }
}
@media (max-width: 640px) {
  .metrics-grid { grid-template-columns: 1fr; }
  .page-heading { flex-direction: column; }
  .toolbar { flex-direction: column; align-items: stretch; }
  .search-form { width: 100%; }
}

/* Compat aliases for existing class names in App.tsx */
.action-menu-wrap { position: relative; display: inline-flex; justify-content: flex-end; }
.menu-dismiss {
  position: fixed; inset: 0; z-index: 15;
  background: transparent; border: 0; cursor: default;
}
.action-menu { z-index: 20; }
.status-pill { display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 999px; font-size: 11px; font-weight: 700; background: var(--surface-3); color: var(--ink-soft); text-transform: capitalize; }
.status-active, .status-pill.status-active { background: var(--green-soft); color: #047857; }
.status-banned, .status-pill.status-banned { background: var(--red-soft); color: var(--brand-red); }
.status-deactivated, .status-pill.status-deactivated { background: var(--surface-3); color: var(--muted); }
.status-pending_review, .status-pill.status-pending_review { background: var(--orange-soft); color: #b45309; }
.status-deleted, .status-pill.status-deleted { background: var(--red-soft); color: #9f1239; }
.plan-premium, .plan-pill.plan-premium { background: var(--purple-soft); color: var(--brand-purple); }
.sub-cell { display: block; margin-top: 4px; color: var(--muted); font-size: 11px; font-weight: 500; text-transform: capitalize; }
.date-cell { color: var(--ink-soft); font-size: 12px; font-weight: 500; white-space: nowrap; }
.user-cell-copy { min-width: 0; }
.verified-icon { display: inline; margin-left: 4px; color: var(--brand-purple); vertical-align: -2px; }
.online-label { display: inline-flex; align-items: center; gap: 6px; color: #047857; font-weight: 700; font-size: 12px; }
.amount-cell { font-family: var(--display); font-weight: 800; }
.danger-menu-item { color: var(--brand-red) !important; }
